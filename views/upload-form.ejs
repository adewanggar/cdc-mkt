<div class="upload-block"><h3><%= target==='logo' ? 'Logo lab':'Foto marketing' %></h3><p class="muted">JPG, PNG, atau WebP · maksimal 2 MB · otomatis dikompres</p><% if(photo) { %><img class="upload-preview" src="<%= photo %>" width="80" height="80" alt="Gambar saat ini"><% } %><form action="/admin/upload" method="post" enctype="multipart/form-data" class="upload-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="target" value="<%= target %>"><input type="hidden" name="contact_id" value="<%= contactId || '' %>"><label>Pilih gambar<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label><button class="button secondary small">Unggah gambar</button></form><% if(photo) { %><form action="/admin/image/remove" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="target" value="<%= target %>"><input type="hidden" name="contact_id" value="<%= contactId || '' %>"><button class="danger-link">Hapus gambar</button></form><% } %></div>
