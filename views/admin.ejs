<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Lab Connect</title><link rel="icon" href="/favicon.svg"><link rel="preload" href="/fonts/jakarta-400.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/styles.css?v=bio-instagram-1"><link rel="stylesheet" href="/theme.css"><script src="/admin.js?v=wa-templates-1" defer></script></head>
<body class="admin-body"><aside class="sidebar"><a class="admin-brand" href="/admin"><%- include('brand') %><span>Lab Connect<small>ADMINISTRATOR</small></span></a><p class="nav-label">RUANG KERJA</p><nav aria-label="Menu admin"><% const nav=[['dashboard','Ringkasan','/admin','dashboard'],['contacts','Kontak marketing','/admin/contacts','contacts'],['branches','Lokasi & cabang','/admin/branches','maps'],['buttons','Tombol tambahan','/admin/buttons','website'],['bio','Bio Instagram','/admin/bio','instagram'],['shortlinks','Shortlink','/admin/shortlinks','website'],['qr','QR kartu nama','/admin/qr','qr'],['settings','Pengaturan lab','/admin/settings','settings'],['users','Kelola admin','/admin/users','shield'],['password','Keamanan akun','/admin/password','shield']];nav.forEach(([key,label,url,icon])=>{ %><a class="nav-item <%= section===key ? 'active':'' %>" href="<%= url %>" <%- section===key ? 'aria-current="page"':'' %>><%- include('icon',{name:icon}) %><%= label %></a><% }); %></nav><div class="sidebar-bottom"><span class="user-avatar"><%= user.name[0] %></span><div><strong><%= user.name %></strong><small>Pengelola lab</small></div><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-button" title="Keluar" aria-label="Keluar"><%- include('icon',{name:'logout'}) %></button></form></div></aside>
<div class="admin-main"><header class="topbar"><span><%= s.lab_name %></span><a class="button secondary small" href="/" target="_blank" rel="noopener">Lihat halaman lab <%- include('icon',{name:'arrow'}) %></a><form class="mobile-logout" action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-button" title="Keluar" aria-label="Keluar"><%- include('icon',{name:'logout'}) %></button></form></header><main class="workspace"><div class="page-heading"><div><p class="eyebrow blue-text">LAB CONNECT / ADMIN</p><h1><%= title %></h1><p class="muted"><%= {dashboard:'Lihat bagaimana kartu nama Anda menghubungkan calon pelanggan.',contacts:'Satu halaman dan QR unik untuk setiap kontak marketing.',branches:'Bantu pengunjung menemukan cabang yang tepat.',buttons:'Atur tautan pelengkap pada halaman kontak.',bio:'Atur halaman khusus untuk link di bio Instagram.',shortlinks:'Ubah link panjang menjadi alamat singkat yang mudah dibagikan.',qr:'Unduh QR siap cetak untuk kartu nama tim Anda.',settings:'Identitas, tampilan, dan informasi utama laboratorium.',users:'Tambahkan pengelola dengan akun login masing-masing.',password:'Perbarui password untuk menjaga akses akun Anda.'}[section] %></p></div><% if(section==='dashboard') { %><a class="button secondary" href="/admin/stats.csv?days=<%= stats.days %>&group=<%= stats.group %><%= stats.contactId ? '&contact='+stats.contactId : '' %>"><%- include('icon',{name:'download'}) %> Ekspor CSV</a><% } %></div>
<% if(success) { %><p class="alert success" role="status"><%- include('icon',{name:'check'}) %> <%= success %></p><% } %>
<% if(section==='dashboard') { %><%- include('dashboard',{stats,contacts}) %><% } %>
<% if(section==='bio') { %><%- include('bio-admin',{bio,bioLinks,origin}) %><% } %>
<% if(section==='shortlinks') { %><%- include('shortlinks',{shortlinks,origin}) %><% } %>
<% if(section==='users') { %><%- include('users',{admins,user}) %><% } %>
<% if(section==='settings') { %><%- include('settings',{s,contacts,dayNames}) %><% } %>
<% if(['contacts','branches','buttons'].includes(section)) { const rows=section==='contacts' ? contacts : section==='branches' ? branches:buttons; %>
 <details class="panel create-panel"><summary><span><%- include('icon',{name:'plus'}) %> Tambah <%= section==='contacts' ? 'kontak' : section==='branches' ? 'cabang':'tombol' %></span></summary><div class="panel-body"><%- include('edit-form',{model:section,row:{is_active:1},branches}) %></div></details>
 <div class="list-toolbar"><strong><%= rows.length %> <%= section==='contacts' ? 'kontak marketing' : section==='branches' ? 'cabang':'tombol tambahan' %></strong><span class="muted">Klik baris untuk mengedit</span></div>
 <div class="records"><% rows.forEach(row=>{ %><details class="panel record"><summary><div class="record-identity"><% if(section==='contacts' && row.photo_path) { %><img class="avatar" src="<%= row.photo_path %>" alt="" width="44" height="44"><% } else { %><span class="record-icon"><%- include('icon',{name:section==='contacts' ? 'contacts':section==='branches' ? 'maps':row.icon}) %></span><% } %><div><strong><%= row.name || row.title %></strong><small><%= section==='contacts' ? row.job_title+' · /m/'+row.slug : section==='branches' ? row.address : row.url %></small></div></div><div class="record-actions"><span class="pill <%= row.is_active ? 'green':'gray' %>"><%= row.is_active ? 'Aktif':'Nonaktif' %></span><%- include('icon',{name:'edit'}) %></div></summary><div class="panel-body"><%- include('edit-form',{model:section,row,branches}) %>
 <% if(section==='contacts') { %><div class="record-tools"><a class="button secondary small" href="/m/<%= row.slug %>" target="_blank" rel="noopener">Lihat halaman <%- include('icon',{name:'arrow'}) %></a><a class="button secondary small" href="/admin/qr">Unduh QR</a></div><%- include('upload-form',{target:'contact',contactId:row.id,photo:row.photo_path}) %><% } %>
 <form action="/admin/<%= section %>/<%= row.id %>/delete" method="post" data-confirm="Hapus data ini? Link QR kontak yang dihapus akan berhenti berfungsi."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-link">Hapus <%= section==='contacts' ? 'kontak' : section==='branches' ? 'cabang':'tombol' %></button></form></div></details><% }); %></div>
 <% if(!rows.length) { %><div class="panel empty-state"><h2>Belum ada data</h2><p>Tambahkan data pertama melalui tombol di atas.</p></div><% } %>
<% } %>
<% if(section==='qr') { %><div class="notice"><%- include('icon',{name:'qr'}) %><p>QR menyimpan link halaman, sehingga perubahan nomor WhatsApp tetap berlaku pada kartu yang sudah dicetak. Gunakan domain final sebelum mencetak.</p></div><div class="qr-grid"><% [{slug:'default',name:'Halaman utama',job_title:'Kontak default'},...contacts.filter(c=>c.is_active)].forEach(c=>{const url=origin+(c.slug==='default' ? '/' : '/m/'+c.slug); %><article class="panel qr-card"><div class="qr-card-heading"><h2><%= c.name %></h2><p class="muted"><%= c.job_title %></p></div><img src="/admin/qr/<%= c.slug %>/svg" width="180" height="180" alt="QR halaman <%= c.name %>"><p class="qr-url"><%= url %></p><div class="qr-downloads"><a class="button primary small" href="/admin/qr/<%= c.slug %>/png" download><%- include('icon',{name:'download'}) %> PNG</a><a class="button secondary small" href="/admin/qr/<%= c.slug %>/svg" download>SVG</a><button class="icon-button copy-button" data-copy="<%= url %>" title="Salin link" aria-label="Salin link"><%- include('icon',{name:'website'}) %></button></div><small class="muted">PNG 1600 px · SVG vektor</small></article><% }); %></div><% } %>
<% if(section==='password') { %><section class="panel narrow-panel"><div class="panel-title"><h2>Ganti password</h2><p class="muted">Minimal 12 karakter. Setelah disimpan, seluruh sesi akan keluar.</p></div><form action="/admin/password" method="post" class="panel-body form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Password saat ini<input type="password" name="current_password" required maxlength="128" autocomplete="current-password"></label><label>Password baru<input type="password" name="new_password" required minlength="12" maxlength="72" autocomplete="new-password"></label><label>Ulangi password baru<input type="password" name="confirm_password" required minlength="12" maxlength="72" autocomplete="new-password"></label><button class="button primary">Simpan password</button></form></section><% } %>
<footer class="admin-footer">Lab Connect <span>Kelola koneksi. Pahami jangkauan.</span></footer></main></div><div id="toast" class="toast" role="status" hidden></div><%- include('customer-care') %></body></html>


