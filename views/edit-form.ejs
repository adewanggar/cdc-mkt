<form action="/admin/<%= model %>/save" method="post" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id || '' %>">
<% if(model==='contacts') { %>
 <label>Nama marketing<input name="name" value="<%= row.name || '' %>" required maxlength="100" placeholder="Nama lengkap"></label><label>Jabatan<input name="job_title" value="<%= row.job_title || '' %>" required maxlength="100" placeholder="Marketing Executive"></label>
 <label>Slug halaman<input name="slug" value="<%= row.slug || '' %>" required maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="budi"><small>/m/slug · Mengubah slug membuat QR lama berhenti berfungsi.</small></label><label>Nomor WhatsApp<input name="wa_number" value="<%= row.wa_number || '' %>" required maxlength="30" inputmode="tel" placeholder="081234567890"><small>Nomor 08xx otomatis menjadi 628xx.</small></label>
 <%- include('wa-message-editor',{field:'wa_message',value:row.wa_message,label:'Pesan WhatsApp otomatis'}) %>
 <label>Lokasi / cabang<select name="branch_id"><option value="">Gunakan lokasi default lab</option><% branches.filter(b=>b.is_active).forEach(b=>{ %><option value="<%= b.id %>" <%= row.branch_id===b.id ? 'selected':'' %>><%= b.name %></option><% }); %></select></label>
<% } else if(model==='branches') { %>
 <label>Nama cabang<input name="name" value="<%= row.name || '' %>" required maxlength="150"></label><label>Link Google Maps<input type="url" name="maps_url" value="<%= row.maps_url || '' %>" required maxlength="2048" placeholder="https://maps.app.goo.gl/..."></label><label class="full-width">Alamat<textarea name="address" required maxlength="500" rows="2"><%= row.address || '' %></textarea></label>
<% } else { %>
 <label>Judul tombol<input name="title" value="<%= row.title || '' %>" required maxlength="100"></label><label>Jenis / ikon<select name="icon"><% [['phone','Telepon'],['instagram','Instagram'],['website','Website'],['catalog','Katalog / PDF']].forEach(([key,label])=>{ %><option value="<%= key %>" <%= row.icon===key ? 'selected':'' %>><%= label %></option><% }); %></select></label><label>URL tujuan<input name="url" value="<%= row.url || '' %>" required maxlength="2048" placeholder="https://... atau tel:+6221..."></label><label>Urutan tampil<input type="number" name="sort_order" min="0" max="999" value="<%= row.sort_order || 0 %>" required></label>
<% } %><label class="checkbox-label"><input type="checkbox" name="is_active" value="1" <%= row.is_active ? 'checked':'' %>> Aktif dan tampil di halaman publik</label><div class="form-actions full-width"><button class="button primary" type="submit"><%- include('icon',{name:'check'}) %> <%= row.id ? 'Simpan perubahan':'Tambahkan' %></button></div></form>
