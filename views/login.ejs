<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login admin · Lab Connect</title><link rel="icon" href="/favicon.svg"><link rel="stylesheet" href="/styles.css?v=customer-care-1"><link rel="stylesheet" href="/theme.css"></head>
<body class="login-body"><main class="login-card"><div class="login-brand"><%- include('brand') %><strong>Lab Connect<span>ADMINISTRATOR</span></strong></div><p class="eyebrow blue-text">SELAMAT DATANG KEMBALI</p><h1>Kelola koneksi lab Anda.</h1><p class="muted">Masuk untuk mengatur kontak, tautan, dan statistik kartu nama.</p>
<% if(error) { %><p class="alert error" role="alert"><%= error %></p><% } %>
<form action="/admin/login" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Email<input type="email" name="email" required maxlength="190" autocomplete="username" placeholder="admin@labanda.id"></label><label>Password<input type="password" name="password" required maxlength="128" autocomplete="current-password" placeholder="Masukkan password"></label><button class="button primary" type="submit">Masuk ke admin <%- include('icon',{name:'arrow'}) %></button></form><a class="back-link" href="/">Kembali ke halaman lab</a><p class="login-note"><%- include('icon',{name:'lock'}) %> Akses khusus pengelola laboratorium</p></main><%- include('customer-care') %></body></html>
