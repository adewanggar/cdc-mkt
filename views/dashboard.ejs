<form class="dashboard-filters" action="/admin" method="get"><label>Periode<select name="days"><% [7,30,90].forEach(n=>{ %><option value="<%= n %>" <%= stats.days===n ? 'selected':'' %>><%= n %> hari terakhir</option><% }); %></select></label><label>Marketing<select name="contact"><option value="">Semua marketing</option><% contacts.forEach(c=>{ %><option value="<%= c.id %>" <%= stats.contactId===c.id ? 'selected':'' %>><%= c.name %></option><% }); %></select></label><label>Grafik<select name="group"><% [['day','Harian'],['week','Mingguan'],['month','Bulanan']].forEach(([v,l])=>{ %><option value="<%= v %>" <%= stats.group===v ? 'selected':'' %>><%= l %></option><% }); %></select></label><button class="button primary small">Terapkan</button></form>
<div class="stat-cards"><% const cards=[['Kunjungan halaman',stats.totals.visits,'qr','blue'],['Klik WhatsApp',stats.totals.whatsapp,'whatsapp','yellow'],['Klik Google Maps',stats.totals.maps,'maps','lightblue'],['Klik tautan lainnya',stats.totals.other,'website','gray']];cards.forEach(([label,value,icon,tone])=>{ %><article class="panel stat-card"><div class="stat-card-label"><span><%= label %></span><span class="stat-icon <%= tone %>"><%- include('icon',{name:icon}) %></span></div><strong><%= Number(value).toLocaleString('id-ID') %></strong><small><%= stats.days %> hari terakhir</small></article><% }); %></div>
<section class="panel chart-panel"><div class="panel-title chart-heading"><div><h2>Aktivitas pengunjung</h2><p class="muted">Kunjungan dan interaksi dari halaman kontak.</p></div><div class="chart-legend"><span><i class="legend-visits"></i>Kunjungan</span><span><i class="legend-wa"></i>WhatsApp</span><span><i class="legend-maps"></i>Maps</span></div></div><div class="panel-body"><% if(!stats.series.length) { %><div class="empty-chart"><%- include('icon',{name:'dashboard'}) %><h3>Statistik akan muncul di sini</h3><p>Buka halaman kontak atau scan QR untuk mulai mencatat kunjungan.</p><a href="/" class="button secondary small" target="_blank" rel="noopener">Lihat halaman lab</a></div><% } else { const max=Math.max(1,...stats.series.flatMap(p=>[Number(p.visits),Number(p.whatsapp),Number(p.maps)])); const x=i=>55+i*700/Math.max(stats.series.length-1,1), y=v=>210-Number(v)/max*170; %><div class="chart-scroll"><svg class="activity-chart" viewBox="0 0 800 260" role="img" aria-label="Grafik aktivitas pengunjung"><% Array.from({length:Math.min(4,max)+1},(_,i)=>i/Math.min(4,max)).forEach(v=>{ %><line x1="55" x2="765" y1="<%= y(v*max) %>" y2="<%= y(v*max) %>" stroke="#edf0f5"/><text x="42" y="<%= y(v*max)+4 %>" text-anchor="end"><%= Math.round(v*max) %></text><% }); %><% [['visits','#004aad'],['whatsapp','#d7aa13'],['maps','#55a0cf']].forEach(([key,col])=>{ %><polyline fill="none" stroke="<%= col %>" stroke-width="3" stroke-linejoin="round" points="<%= stats.series.map((p,i)=>x(i)+','+y(p[key])).join(' ') %>"/><% stats.series.forEach((p,i)=>{ %><circle cx="<%= x(i) %>" cy="<%= y(p[key]) %>" r="3.5" fill="<%= col %>"><title><%= p.bucket %> · <%= key %>: <%= p[key] %></title></circle><% }); %><% }); %><% stats.series.forEach((p,i)=>{ if(i===0 || i===stats.series.length-1 || i%Math.ceil(stats.series.length/6)===0) { %><text x="<%= x(i) %>" y="240" text-anchor="middle"><%= p.bucket %></text><% } }); %></svg></div><% } %></div></section>
<div class="dashboard-bottom"><section class="panel"><div class="panel-title"><h2>Performa marketing</h2><p class="muted">Kontak yang menjangkau pengunjung Anda.</p></div><div class="table-scroll"><table><thead><tr><th>Marketing</th><th>Kunjungan</th><th>WhatsApp</th><th>Maps</th></tr></thead><tbody><% stats.byContact.forEach(c=>{ %><tr><td><strong><%= c.name %></strong><small><%= c.slug ? '/m/'+c.slug : 'Kontak umum' %></small></td><td><%= c.visits %></td><td><%= c.whatsapp %></td><td><%= c.maps %></td></tr><% }); %><% if(!stats.byContact.length) { %><tr><td colspan="4" class="muted">Belum ada aktivitas pada periode ini.</td></tr><% } %></tbody></table></div></section><section class="panel device-panel"><div class="panel-title"><h2>Perangkat pengunjung</h2><p class="muted">Berdasarkan kunjungan halaman.</p></div><div class="panel-body"><% const total=Math.max(1,Number(stats.totals.visits)); [['mobile','Ponsel'],['desktop','Desktop'],['tablet','Tablet']].forEach(([key,label])=>{const count=Number(stats.byDevice.find(d=>d.device_type===key)?.visits || 0); %><div class="device-item"><div><span><%= label %></span><strong><%= count %> <small>(<%= Math.round(count/total*100) %>%)</small></strong></div><meter min="0" max="<%= total %>" value="<%= count %>" aria-label="Kunjungan <%= label %>"></meter></div><% }); %></div></section></div><p class="analytics-note">Kunjungan adalah pembukaan halaman, termasuk kunjungan ulang; bukan jumlah scan QR fisik yang unik. Semua waktu ditampilkan dalam WIB.</p>
