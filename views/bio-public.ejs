<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= bio.title %></title><meta name="description" content="<%= bio.description %>"><meta property="og:title" content="<%= bio.title %>"><meta property="og:description" content="<%= bio.description %>"><meta property="og:type" content="website"><meta property="og:url" content="<%= canonical %>">
<link rel="canonical" href="<%= canonical %>"><link rel="icon" href="/favicon.svg"><link rel="preload" href="/fonts/jakarta-400.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/styles.css?v=locations-plain-1"><link rel="stylesheet" href="/bio/theme.css"><script src="/locations.js?v=1" defer></script></head>
<body class="public-body bio-instagram"><main class="bio-shell"><header class="bio-header">
<% if(bio.logo_path) { %><div class="lab-logo-mark"><img src="<%= bio.logo_path %>" alt="Logo <%= bio.title %>" width="972" height="433"></div><% } %>
<h1 class="<%= bio.show_title ? '' : 'sr-only' %>"><%= bio.title %></h1><% if(bio.description) { %><p class="tagline"><%= bio.description %></p><% } %>
<svg class="header-wave" viewBox="0 0 480 48" preserveAspectRatio="none" aria-hidden="true"><path d="M0 20Q120 60 240 29T480 20V48H0Z"/></svg></header>
<div class="bio-content"><div class="instagram-groups"><% groups.forEach(group=>{ %><section class="instagram-section" <%- group.id ? 'aria-labelledby="bio-section-'+group.id+'"' : 'aria-label="Link Bio Instagram"' %>>
<% if(group.title) { %><h2 id="bio-section-<%= group.id %>" class="instagram-section-title"><%= group.title %></h2><% } %>
<nav class="instagram-links" aria-label="<%= group.title || 'Link Bio Instagram' %>"><% group.links.forEach(link=>{ %><a class="cta cta-maps" href="<%= link.url==='#locations' ? locations[0].maps_url : link.url %>" <%- link.url==='#locations' ? 'data-location-picker aria-haspopup="dialog" aria-controls="location-dialog"':'' %>><span class="cta-icon"><%- include('icon',{name:link.icon}) %></span><span><strong><%= link.title %></strong><% if(link.subtitle) { %><small><%= link.subtitle %></small><% } %></span><%- include('icon',{name:'arrow',cls:'cta-arrow'}) %></a><% }); %></nav></section><% }); %></div>
<% if(!links.some(link=>link.url==='#locations')) { %><div class="bio-locations-action"><a class="cta cta-maps" href="<%= locations[0].maps_url %>" data-location-picker aria-haspopup="dialog" aria-controls="location-dialog"><span class="cta-icon"><%- include('icon',{name:'maps'}) %></span><span><strong>Lihat Lokasi</strong><small>Pilih cabang & buka Google Maps</small></span><%- include('icon',{name:'arrow',cls:'cta-arrow'}) %></a></div><% } %>
<section class="lab-info-plain visit-locations" id="locations" aria-labelledby="bio-visit-title"><h2 class="visit-title" id="bio-visit-title">Kunjungi kami</h2><%- include('location-list',{locations,showMaps:false}) %></section>
<footer class="bio-footer"><span><%= bio.title %></span></footer></div></main><%- include('location-dialog',{locations}) %><%- include('customer-care') %></body></html>
