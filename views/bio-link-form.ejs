<form action="/admin/biolinks/save" method="post" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= row.id || '' %>">
<label>Judul tombol<input name="title" value="<%= row.title || '' %>" maxlength="150" required placeholder="Contoh: Promo pemeriksaan"></label><label>Keterangan tombol<input name="subtitle" value="<%= row.subtitle || '' %>" maxlength="200" placeholder="Opsional"></label>
<label class="full-width">Link tujuan<input name="url" value="<%= row.url || '' %>" maxlength="2048" required placeholder="https://..."><small>Gunakan HTTPS. Untuk ikon Telepon: tel:+62...</small></label>
<label>Ikon<select name="icon"><% [['website','Website'],['whatsapp','WhatsApp'],['maps','Lokasi'],['instagram','Instagram'],['catalog','Katalog / layanan'],['phone','Telepon']].forEach(([key,label])=>{ %><option value="<%= key %>" <%= row.icon===key ? 'selected':'' %>><%= label %></option><% }); %></select></label>
<label>Urutan<input type="number" name="sort_order" min="0" max="999" value="<%= row.sort_order || 0 %>" required></label><label class="checkbox-label"><input type="checkbox" name="is_active" value="1" <%= row.is_active ? 'checked':'' %>> Tampilkan tombol</label>
<div class="form-actions full-width"><button class="button primary"><%- include('icon',{name:row.id ? 'check':'plus'}) %> <%= row.id ? 'Simpan perubahan':'Tambah tombol' %></button></div></form>
