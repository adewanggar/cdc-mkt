<div class="location-list"><% locations.forEach(location=>{ %><article class="<%= showMaps ? 'location-card':'location-entry' %>"><div class="info-row"><%- include('icon',{name:'maps'}) %><div><h3><%= location.name %></h3><p><%= location.address %></p><% if(showMaps) { %><a class="location-map-link" href="<%= location.maps_url %>">Buka Google Maps <%- include('icon',{name:'arrow'}) %></a><% } %></div></div></article><% }); %></div>
