<form action="/admin/settings" method="post" class="settings-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
<section class="panel"><div class="panel-title"><h2>Identitas laboratorium</h2><p class="muted">Informasi ini tampil pada semua halaman kontak.</p></div><div class="panel-body form-grid"><label>Nama lab<input name="lab_name" value="<%= s.lab_name %>" maxlength="150" required></label><label>Tagline<input name="tagline" value="<%= s.tagline %>" maxlength="200"></label><label class="checkbox-label full-width"><input type="checkbox" name="show_lab_name" value="1" <%= s.show_lab_name ? 'checked':'' %>> Tampilkan nama lab di bawah logo</label><label class="full-width">Sapaan pengunjung<input name="greeting" value="<%= s.greeting %>" maxlength="200" placeholder="Kosongkan untuk menyembunyikan sapaan"></label><label class="full-width">Alamat default<textarea name="address" rows="2" maxlength="500" required><%= s.address %></textarea></label></div></section>
<section class="panel"><div class="panel-title"><h2>Kontak & lokasi default</h2><p class="muted">Digunakan pada halaman utama dan saat kontak tidak memiliki cabang.</p></div><div class="panel-body form-grid"><label>Kontak halaman utama<select name="default_contact_id"><option value="">Gunakan nomor default di bawah</option><% contacts.filter(c=>c.is_active).forEach(c=>{ %><option value="<%= c.id %>" <%= s.default_contact_id===c.id ? 'selected':'' %>><%= c.name %></option><% }); %></select></label><label>Nomor WhatsApp default<input name="default_wa_number" value="<%= s.default_wa_number %>" maxlength="30" required inputmode="tel"></label><%- include('wa-message-editor',{field:'default_wa_message',value:s.default_wa_message,label:'Pesan otomatis default'}) %><label class="full-width">Link Google Maps default<input type="url" name="default_maps_url" value="<%= s.default_maps_url %>" maxlength="2048" required></label></div></section>
<section class="panel"><div class="panel-title"><h2>Jam operasional</h2><p class="muted">Zona waktu WIB (Asia/Jakarta). Status buka/tutup dihitung otomatis.</p></div><div class="panel-body hours-grid"><% [1,2,3,4,5,6,0].forEach(d=>{const h=s.opening_hours[d]; %><div class="hours-row"><strong><%= dayNames[d] %></strong><label><span class="sr-only">Jam buka <%= dayNames[d] %></span><input type="time" name="open_<%= d %>" value="<%= h?.open || '07:00' %>" required></label><span>–</span><label><span class="sr-only">Jam tutup <%= dayNames[d] %></span><input type="time" name="close_<%= d %>" value="<%= h?.close || '20:00' %>" required></label><label class="checkbox-label"><input type="checkbox" name="closed_<%= d %>" value="1" <%= !h ? 'checked':'' %>> Tutup</label></div><% }); %></div></section>
<section class="panel"><div class="panel-title"><h2>Tampilan & pencarian</h2></div><div class="panel-body form-grid"><label>Warna utama<input type="color" name="primary_color" value="<%= s.primary_color %>" required></label><label>Warna aksen<input type="color" name="accent_color" value="<%= s.accent_color %>" required></label><label class="checkbox-label full-width"><input type="checkbox" name="marketing_noindex" value="1" <%= s.marketing_noindex ? 'checked':'' %>> Sembunyikan halaman marketing dari mesin pencari (noindex)</label></div></section><div class="form-actions"><button class="button primary"><%- include('icon',{name:'check'}) %> Simpan pengaturan</button></div></form>
<section class="panel"><div class="panel-body"><%- include('upload-form',{target:'logo',contactId:null,photo:s.logo_path}) %></div></section>
