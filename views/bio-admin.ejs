<section class="panel"><div class="panel-title"><h2>Halaman Bio Instagram</h2><p class="muted">Isi dan tampilan halaman ini diatur sendiri.</p></div><form action="/admin/bio" method="post" class="panel-body form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label class="full-width">Judul halaman<input name="title" value="<%= bio.title %>" required maxlength="150"></label><label class="full-width">Deskripsi<textarea name="description" maxlength="500" rows="3"><%= bio.description %></textarea></label>
<label>Warna utama<input type="color" name="primary_color" value="<%= bio.primary_color %>" required></label><label>Warna aksen<input type="color" name="accent_color" value="<%= bio.accent_color %>" required></label>
<label class="checkbox-label"><input type="checkbox" name="show_title" value="1" <%= bio.show_title ? 'checked':'' %>> Tampilkan judul di bawah logo</label><label class="checkbox-label"><input type="checkbox" name="is_active" value="1" <%= bio.is_active ? 'checked':'' %>> Halaman aktif</label>
<div class="form-actions full-width"><button class="button primary">Simpan halaman</button><a class="button secondary" href="/bio" target="_blank" rel="noopener">Lihat halaman</a><button class="button secondary" type="button" data-copy="<%= origin %>/bio">Salin link bio</button></div><p class="shortlink-address full-width"><%= origin %>/bio</p></form></section>
<details class="panel bio-logo-panel"><summary class="panel-title"><h2>Logo Bio Instagram</h2></summary><div class="panel-body"><%- include('upload-form',{target:'biologo',contactId:null,photo:bio.logo_path}) %></div></details>
<section class="panel"><div class="panel-title"><h2>Section / kelompok tombol</h2><p class="muted">Buat judul kelompok, lalu pilih section pada setiap tombol. Urutan kecil tampil lebih dulu. Tombol tanpa section tampil paling atas.</p></div><div class="panel-body"><%- include('bio-section-form',{row:{is_active:1}}) %></div></section>
<div class="records"><% bioSections.forEach(row=>{ %><details class="panel record"><summary><div class="record-identity"><div><strong><%= row.title %></strong><small>Urutan <%= row.sort_order %> · <%= bioLinks.filter(link=>link.section_id===row.id).length %> tombol</small></div></div><span class="pill <%= row.is_active ? 'green':'gray' %>"><%= row.is_active ? 'Tampil':'Disembunyikan' %></span></summary><div class="panel-body"><%- include('bio-section-form',{row}) %><form action="/admin/biosections/<%= row.id %>/delete" method="post" data-confirm="Hapus section? Tombol di dalamnya tetap tersimpan dan dipindahkan ke Tanpa section."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-link">Hapus section</button></form></div></details><% }); %></div>
<section class="panel"><div class="panel-title"><h2>Tambah tombol</h2><p class="muted">Isi sendiri link yang ingin ditampilkan di bio Instagram.</p></div><div class="panel-body"><%- include('bio-link-form',{row:{is_active:1}}) %></div></section>
<div class="list-toolbar"><strong><%= bioLinks.length %> tombol Bio Instagram</strong><span class="muted">Klik baris untuk mengedit</span></div><div class="records"><% bioLinks.forEach(row=>{ %><details class="panel record"><summary><div class="record-identity"><span class="record-icon"><%- include('icon',{name:row.icon}) %></span><div><strong><%= row.title %></strong><small>Urutan <%= row.sort_order %></small></div></div><span class="pill <%= row.is_active ? 'green':'gray' %>"><%= row.is_active ? 'Tampil':'Disembunyikan' %></span></summary><div class="panel-body"><%- include('bio-link-form',{row}) %><form action="/admin/biolinks/<%= row.id %>/delete" method="post" data-confirm="Hapus tombol dari Bio Instagram?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger-link">Hapus tombol</button></form></div></details><% }); %></div>
<% if(!bioLinks.length) { %><div class="panel empty-state"><h2>Belum ada tombol</h2><p>Tambahkan link melalui formulir di atas.</p></div><% } %>
