NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lab_connect
DB_USER=lab_connect
DB_PASSWORD=replace-with-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-another-32-random-characters
# 0 locally; 1 only behind a single trusted reverse proxy.
TRUST_PROXY=0
# Seed admin is disabled until db:init sets a bcrypt hash from these values.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-password
# Only for the optional Docker Compose setup:
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
